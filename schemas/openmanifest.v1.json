{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenManifestToken",
  "description": "Federated eFTI Common Data Set (CDS) compliant token for Project ZeST intermodal transfers under EU 2020/1056.",
  "type": "object",
  "required": [
    "token_id",
    "consignment_reference",
    "transport_equipment",
    "regulatory_declarations",
    "zest_corridor_routing"
  ],
  "properties": {
    "token_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique cryptographic transaction identifier."
    },
    "consignment_reference": {
      "type": "object",
      "required": ["bill_of_lading_number", "origin_port_locode"],
      "properties": {
        "bill_of_lading_number": { "type": "string" },
        "origin_port_locode": { "type": "string", "pattern": "^[A-Z]{2}[A-Z0-9]{3}$" }
      }
    },
    "transport_equipment": {
      "type": "object",
      "required": ["container_id", "iso_size_type", "vgm_kg"],
      "properties": {
        "container_id": {
          "type": "string",
          "pattern": "^[A-Z]{4}[0-9]{7}$",
          "description": "ISO 6346 Container Number."
        },
        "iso_size_type": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}$"
        },
        "vgm_kg": {
          "type": "number",
          "minimum": 2000,
          "maximum": 35000,
          "description": "SOLAS Verified Gross Mass in kg."
        }
      }
    },
    "regulatory_declarations": {
      "type": "object",
      "required": ["customs_status", "hazmat_imdg_class"],
      "properties": {
        "customs_status": {
          "type": "string",
          "enum": ["UNION_GOODS", "NCTS_T1_TRANSIT", "PRE_CLEARED_UCC"],
          "description": "Customs transit regime; NCTS T1 permits inland clearance."
        },
        "hazmat_imdg_class": {
          "type": "string",
          "enum": ["NONE", "1", "2", "3", "4", "5", "6", "7", "8", "9"]
        }
      }
    },
    "zest_corridor_routing": {
      "type": "object",
      "required": ["gateway_locode", "destination_zone_code", "inland_dry_port_locode", "target_train_slot"],
      "properties": {
        "gateway_locode": {
          "type": "string",
          "pattern": "^[A-Z]{2}[A-Z0-9]{3}$",
          "description": "UN/LOCODE of destination seaport (e.g., NLRTM)."
        },
        "destination_zone_code": {
          "type": "string",
          "pattern": "^ZONE_[1-6]$",
          "description": "Coarse geographic delivery zone."
        },
        "inland_dry_port_locode": {
          "type": "string",
          "pattern": "^[A-Z]{2}[A-Z0-9]{3}$",
          "description": "Destination dry port siding (e.g., DUDUI)."
        },
        "target_train_slot": {
          "type": "string",
          "description": "Pre-booked TEN-T rail corridor timetable slot."
        }
      }
    }
  },
  "additionalProperties": false
}
