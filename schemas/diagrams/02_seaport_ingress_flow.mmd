            direction LR
            PP_STS["STS Quay Crane<br/>Discharges Pre-Blocked Hatch"] ==> PP_DECISION{"Token Verified<br/>at Quayside?"}
            PP_DECISION == "✅ YES: Pre-Cleared Fast Path" ==> PP_DIRECT["Direct AGV / Straddle Spine<br/>(Bypasses Yard Stack Completely)"]
