      <Placemark>
        <name>Rotterdam / Antwerp-Bruges Catchment (27.9M TEU)</name>
        <styleUrl>#zone_rotterdam_antwerp</styleUrl>
        <ExtendedData>
  <Data name="Seaport Cluster"><value>Port of Rotterdam &amp; Port of Antwerp-Bruges</value></Data>
  <Data name="2025/26 Cluster Volume"><value>27.9M TEU</value></Data>
  <Data name="TEN-T Rail Corridors"><value>RFC Rhine-Alpine (I), North Sea-Med (II), North Sea-Baltic (VIII)</value></Data>
  <Data name="Natural Inland Hubs"><value>Duisburg, Venlo, Cologne, Brussels, Metz</value></Data>
  <Data name="Systems Architecture Note"><value>Legacy Northern Range mega-hub cluster; currently overreaches across 2-3 closer Southern/Adriatic port zones.</value></Data>
</ExtendedData>
